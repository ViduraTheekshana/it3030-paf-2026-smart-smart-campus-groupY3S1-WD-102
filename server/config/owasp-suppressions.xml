<?xml version="1.0" encoding="UTF-8"?>
<suppressions xmlns="https://jeremylong.github.io/DependencyCheck/dependency-suppression.1.3.xsd">

    <!-- CVE-2022-31691: Affects Spring Tools Suite IDE, NOT spring-boot-devtools.
         DevTools is also optional=true and excluded from production builds. -->
    <suppress>
        <notes>False positive - CVE affects Spring Tools IDE not DevTools jar</notes>
        <packageUrl regex="true">^pkg:maven/org\.springframework\.boot/spring\-boot\-devtools@.*$</packageUrl>
        <cve>CVE-2022-31691</cve>
    </suppress>

    <!-- CVE-2025-15104: Low severity in hibernate-validator, not exploitable here -->
    <suppress>
        <notes>Low severity, input validation context not applicable</notes>
        <packageUrl regex="true">^pkg:maven/org\.hibernate\.validator/hibernate\-validator@.*$</packageUrl>
        <cve>CVE-2025-15104</cve>
    </suppress>

    <!-- CVE-2025-7962: Low severity in angus-activation (mail library) -->
    <suppress>
        <notes>Low severity, mail activation not used in production endpoints</notes>
        <packageUrl regex="true">^pkg:maven/org\.eclipse\.angus/angus\-activation@.*$</packageUrl>
        <cve>CVE-2025-7962</cve>
    </suppress>

</suppressions>
